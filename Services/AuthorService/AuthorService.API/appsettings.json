{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "${your-very-secure-key-with-at-least-32-characters}", // Значение будет взято из переменной окружения
    "Issuer": "AuthorService",
    "Audience": "ApiGateway",
    "ExpiryInMinutes": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=mssql,1433;Database=Example;User Id=sa;Password=YourStrong123#Password;TrustServerCertificate=True;"
  },
  "MessageBroker": {
    "Host": "rabbitmq://messagebroker",
    "UserName": "guest",
    "Password": "guest"
  }

