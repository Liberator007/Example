{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Key": "${your-very-secure-key-with-at-least-32-characters}", // Значение будет взято из переменной окружения
    "Issuer": "AuthorService",
    "Audience": "ApiGateway"
    //"ExpiryInMinutes": 30
  },

  "ReverseProxy": {
    "Routes": {
      "author-route": {
        "ClusterId": "author-cluster",
        "Match": {
          "Path": "/author/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/author" }
        ]
      }
      //"post-route": {
      //  "ClusterId": "post-cluster",
      //  "AuthorizationPolicy": "require-jwt", // JWT для /posts
      //  "Match": {
      //    "Path": "/post/{**catch-all}"
      //  },
      //  "Transforms": [
      //    { "PathRemovePrefix": "/post" },
      //    {
      //      "RequestHeader": "X-Author-Id",
      //      "Set": "{user.claims.nameidentifier}"
      //    }
      //  ]
      //}
    },
    "Clusters": {
      "author-cluster": {
        "Destinations": {
          "authorService": {
            "Address": "http://authorservice.api:8080" // Может тут нужен порт 5000 или 5001
          }
        }
      }
      //"post-cluster": {
      //  "Destinations": {
      //    "postService": {
      //      "Address": "http://postservice:8080"
      //    }
      //  }
      //}
    }
  }
}
